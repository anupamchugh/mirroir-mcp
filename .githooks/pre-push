#!/usr/bin/env bash
# ABOUTME: Pre-push hook — requires a fresh runner/ validation marker for the exact
# ABOUTME: commit being pushed, but ONLY when the push actually contains runner/ changes.

set -euo pipefail

# Must match VALIDATION_TTL_SECONDS in runner/scripts/ci/pre-push-validate.sh.
VALIDATION_TTL_SECONDS=900

GIT_DIR="$(git rev-parse --git-dir)"
MARKER="$GIT_DIR/validation-passed"
VALIDATE_SCRIPT="runner/scripts/ci/pre-push-validate.sh"
ZERO_OID="0000000000000000000000000000000000000000"

# The runner validation gate only protects the Rust workspace, so a push that
# changes no runner/ files (e.g. Swift-only or docs) does not need the marker.
# Refs arrive on stdin as "<local-ref> <local-oid> <remote-ref> <remote-oid>".
runner_touched=false
while read -r _local_ref local_oid _remote_ref remote_oid; do
    [ "$local_oid" = "$ZERO_OID" ] && continue   # branch deletion — nothing to push
    if [ "$remote_oid" = "$ZERO_OID" ]; then
        # New remote branch: scope the diff to commits past origin/main when that
        # base is reachable; otherwise be conservative and require validation.
        base="$(git merge-base "$local_oid" origin/main 2>/dev/null || true)"
        if [ -z "$base" ]; then
            runner_touched=true
            break
        fi
        range="$base..$local_oid"
    else
        range="$remote_oid..$local_oid"
    fi
    if git diff --name-only "$range" 2>/dev/null | grep -q '^runner/'; then
        runner_touched=true
        break
    fi
done

if [ "$runner_touched" = false ]; then
    echo "pre-push: no runner/ changes in push range — skipping runner validation gate."
    exit 0
fi

fail() {
    echo "ERROR: push blocked — $1"
    echo ""
    echo "Run the runner validation gate first:"
    echo "  ./$VALIDATE_SCRIPT"
    echo ""
    echo "It stamps $MARKER (timestamp + commit SHA, valid for $((VALIDATION_TTL_SECONDS / 60)) minutes)."
    exit 1
}

if [ ! -f "$MARKER" ]; then
    fail "no validation marker found"
fi

# Marker format: "<unix-timestamp> <commit-sha>". The SHA field is optional for
# backward compatibility with markers stamped by older validate scripts; when
# absent, only the freshness check applies.
read -r STAMP MARKER_COMMIT _ < "$MARKER" || true
case "$STAMP" in
    ''|*[!0-9]*) fail "validation marker is corrupt" ;;
esac

NOW="$(date +%s)"
AGE=$((NOW - STAMP))

if [ "$AGE" -lt 0 ] || [ "$AGE" -gt "$VALIDATION_TTL_SECONDS" ]; then
    fail "validation marker is stale (${AGE}s old, max ${VALIDATION_TTL_SECONDS}s)"
fi

HEAD_COMMIT="$(git rev-parse HEAD)"
if [ -n "${MARKER_COMMIT:-}" ] && [ "$MARKER_COMMIT" != "$HEAD_COMMIT" ]; then
    fail "validation marker is for a different commit (marker ${MARKER_COMMIT:0:12}, HEAD ${HEAD_COMMIT:0:12})"
fi

echo "pre-push: validation marker is fresh (${AGE}s old) for commit ${HEAD_COMMIT:0:12} — allowing push."
exit 0
